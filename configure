TAGSFLAGS="--langmap='c:+.idl.l.rh,make:(Make*.in)'"

WINE_APPEND_RULE(
TAGS etags:
	rm -f TAGS
	(test -d .git && git ls-files || find -L $srcdir -name '*.[[ch]]' -print) | xargs etags -a \$(TAGSFLAGS)
