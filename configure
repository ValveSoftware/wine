rm -f core conftest.err conftest.$ac_objext conftest.$ac_ext
             eval CC=\$${wine_arch}_CC
             if eval test \"x\$"$as_wine_cv_crosscc_c99"\" = x"no"; then :

else
  break
fi
         done
fi

    eval res=\$$as_wine_cv_crosscc_c99

    case "x$res" in
      x) { $as_echo "$as_me:${as_lineno-$LINENO}: result: none needed" >&5
$as_echo "none needed" >&6; } ;;
      xno) { $as_echo "$as_me:${as_lineno-$LINENO}: result: unsupported" >&5
$as_echo "unsupported" >&6; }
           if ${enable_archs+:} false; then :
  as_fn_error $? "$wine_arch PE cross-compiler supporting C99 not found.
This is an error since --enable-archs=$wine_arch was requested." "$LINENO" 5
