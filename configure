        continue
    fi

    eval "${wine_arch}_TARGET=\$target"
    eval "${wine_arch}_STRIP=\$target_strip"
    as_wine_cv_crosscc_c99=`$as_echo "ac_cv_${wine_arch}_crosscc_c99" | $as_tr_sh`

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking for $CC option to enable C99 features" >&5
$as_echo_n "checking for $CC option to enable C99 features... " >&6; }
    if eval \${$as_wine_cv_crosscc_c99+:} false; then :
  $as_echo_n "(cached) " >&6
else
  eval "$as_wine_cv_crosscc_c99=no"
         for arg in '' '-std=gnu99' '-D__STDC__'
         do
             test -z "$arg" || CC="$CC $arg"
             cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */
$ac_c_conftest_c99_program
_ACEOF
if ac_fn_c_try_compile "$LINENO"; then :
  eval "$as_wine_cv_crosscc_c99=\$arg"
