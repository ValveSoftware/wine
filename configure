           continue
           ;;
      x*) { $as_echo "$as_me:${as_lineno-$LINENO}: result: $res" >&5
$as_echo "$res" >&6; }
          as_fn_append ${wine_arch}_CC " $res" ;;
    esac

    if test "x$wine_arch" = xi386; then :

else
  as_wine_cv_seh_support=`$as_echo "ac_cv_${wine_arch}_seh_support" | $as_tr_sh`

               { $as_echo "$as_me:${as_lineno-$LINENO}: checking whether $CC supports SEH directives" >&5
$as_echo_n "checking whether $CC supports SEH directives... " >&6; }
if eval \${$as_wine_cv_seh_support+:} false; then :
  $as_echo_n "(cached) " >&6
