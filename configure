{
__clear_cache((void*)0, (void*)0); return 0;
  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_link "$LINENO"; then :
  ac_cv_have___clear_cache="yes"
else
  ac_cv_have___clear_cache="no"
fi
rm -f core conftest.err conftest.$ac_objext \
    conftest$ac_exeext conftest.$ac_ext
fi
